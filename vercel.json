{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {"source":"/perspective","destination":"/about#perspective","permanent":true},
    {"source":"/perspective.html","destination":"/about#perspective","permanent":true}
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/newsletter",
      "schedule": "0 16 * * 5"
    }
  ],
  "functions": {
    "api/newsletter-recovery.js": {
      "maxDuration": 180,
      "includeFiles": "server/newsletter-{recovery,store,records}.js"
    },
    "api/editorial-import.js": {
      "maxDuration": 300,
      "includeFiles": "{supabase/migrations/20261007220625_folkly_editorial.sql,web/vercel/{articles,manual-releases}.json}"
    },
    "api/owner-translations.js": {
      "maxDuration": 60,
      "includeFiles": "{build/translation-contracts/**,web/vercel/translation-glossary.json}"
    },
    "api/owner-newsletter.js": {
      "includeFiles": "web/vercel/{articles,routes}.json"
    },
    "api/newsletter.js": {
      "maxDuration": 300,
      "includeFiles": "web/vercel/{articles,routes}.json"
    },
    "api/owner-workspace.js": {
      "maxDuration": 60
    },
    "api/owner-newsletter-test.js": {
      "maxDuration": 60,
      "includeFiles": "web/vercel/{articles,routes}.json"
    }
  }
}

