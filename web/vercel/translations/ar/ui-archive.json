200","text":"وسوم المقال"},{"id":"s0201","text":"الطعام"},{"id":"s0202","text":"المطابخ الجماعية"},{"id":"s0203","text":"الوصفات"},{"id":"s0204","text":"النجم الذي يكسب السنة"},{"id":"s0205","text":"اقرأ «النجم الذي يكسب السنة»"},{"id":"s0206","text":"عنقود الثريّا، المعروف بـ Matariki، أمام حقل نجمي داكن"},{"id":"s0207","text":"أوتياروا نيوزيلندا"},{"id":"s0208","text":"النجم الذي يكسب السنة"},{"id":"s0209","text":"يميّز Matariki وPuanga السنة الماورية الجديدة عبر تقاليد إقليمية متمايزة في الذكرى والمعرفة الفصلية والتجدد."},{"id":"s0210","text":"وسوم المقال"},{"id":"s0211","text":"المراسيم"},{"id":"s0212","text":"التجدد"},{"id":"s0213","text":"الذاكرة"},{"id":"s0214","text":"القِدر التي تُحرَّك: كيف يُثبِّت السوماناك الانتماء في دوشانبه"},{"id":"s0215","text":"اقرأ «القِدر التي تُحرَّك: كيف يُثبِّت السوماناك الانتماء في دوشانبه»"},{"id":"s0216","text":"متجمعون حول قِدر كبيرة من السوماناك في طاجيكستان"},{"id":"s0217","text":"دوشانبه، طاجيكستان"},{"id":"s0218","text":"القِدر التي تُحرَّك: كيف يُثبِّت السوماناك الانتماء في دوشانبه"},{"id":"s0219","text":"في دوشانبه بطاجيكستان، يجلب إعداد السوماناك لعيد Navruz الجيرانَ حول قِدر مشتركة وحضور الربيع."},{"id":"s0220","text":"وسوم المقال"},{"id":"s0221","text":"الطعام"},{"id":"s0222","text":"الطقوس"},{"id":"s0223","text":"التجدد"},{"id":"s0224","text":"ثِقل الأزرق: النيلة والعمل والاقتصاد الحي في توكوشيما"},{"id":"s0225","text":"اقرأ «ثِقل الأزرق: النيلة والعمل والاقتصاد الحي في توكوشيما»"},{"id":"s0226","text":"واجهة ولافتة يابانية لبيت صباغة Furusho في توكوشيما"},{"id":"s0227","text":"محافظة توكوشيما، اليابان"},{"id":"s0228","text":"ثِقل الأزرق: النيلة والعمل والاقتصاد الحي في توكوشيما"},{"id":"s0229","text":"في توكوشيما باليابان، تصل صباغة النيلة aizome بين التخمير والعمل الماهر وأرزاقٍ تدعم حرفةً حية."},{"id":"s0230","text":"وسوم المقال"},{"id":"s0231","text":"المنسوجات"},{"id":"s0232","text":"الصباغة"},{"id":"s0233","text":"معرفة المواد"},{"id":"s0234","text":"التراب الحيّ في شوتشيميلكو"},{"id":"s0235","text":"اقرأ «ا